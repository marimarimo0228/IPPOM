# このファイルには「名前だけ」を書く。値は .env.local（コミットされない）か Vercel の環境変数に入れる。
# それぞれの取得手順は README.md を参照。

# --- 秘密（ブラウザに出してはいけない） ---
GROQ_API_KEY=
SITE_PASSPHRASE=
SESSION_SECRET=

# --- 秘密ではない ---
GROQ_MODEL=
PUBLIC_UNTIL=

# 点数固定のデバッグ用URLパラメータ（/room?total=7）を本番でも有効にするときだけ 1 を入れる。
# 開発時（npm run dev）は常に有効。
NEXT_PUBLIC_DEBUG=

# --- Firebase（ブラウザに出てよい） ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
